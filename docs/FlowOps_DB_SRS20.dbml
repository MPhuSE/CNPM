// FlowOps DB 2.0 DRAFT - synchronized with supplied SRS 2.0
// Paste all content into https://dbdiagram.io
// Diagram source, NOT a complete production migration.
// See document for partial indexes, checks, immutable guards and transactions.
Project FlowOps {
  database_type: 'PostgreSQL'
  Note: '21 tables; 3 system roles; approval groups; immutable revisions; URL references only. Proposed decisions require SRS confirmation.'
}

Table departments {
  id bigint [pk, increment]
  code varchar(50) [not null, unique]
  name varchar(150) [not null]
  parent_id bigint [note: 'Phòng ban cha; kiểm tra cả chu trình gián tiếp.']
  manager_id bigint [note: 'Người giữ chức danh hiện tại; snapshot vào hồ sơ khi gửi.']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Phòng ban; trưởng bộ phận là chức danh, không phải role.'
}

Table users {
  id bigint [pk, increment]
  username varchar(100) [not null, unique]
  email varchar(255) [not null, note: 'Migration tạo unique lower(email).']
  password_hash varchar(255) [not null, note: 'Băm mật khẩu, không mã hóa có thể giải ngược.']
  full_name varchar(200) [not null]
  department_id bigint
  manager_id bigint [note: 'Quản lý trực tiếp hiện tại.']
  is_active boolean [not null, default: true]
  auth_version bigint [not null, default: 0, note: 'Tăng khi đổi mật khẩu hoặc vô hiệu tài khoản để thu hồi tất cả phiên.']
  lock_version bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Tài khoản giữ lịch sử bằng vô hiệu hóa; không hard delete.'
}

Table roles {
  id bigint [pk, increment]
  code varchar(30) [not null, unique]
  name varchar(100) [not null]
  Note: 'Chỉ seed ROLE_ADMIN, ROLE_EMPLOYEE, ROLE_APPROVER; không dùng role làm nhóm nghiệp vụ.'
}

Table user_roles {
  user_id bigint [not null]
  role_id bigint [not null]
  assigned_by bigint [not null]
  assigned_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, role_id) [pk]
  }
  Note: 'Quyền nhiều vai trò; mọi thay đổi có audit.'
}

Table approval_groups {
  id bigint [pk, increment]
  code varchar(80) [not null, unique]
  name varchar(150) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Nhóm Tài chính, Kế toán, IT độc lập với role.'
}

Table approval_group_members {
  group_id bigint [not null]
  user_id bigint [not null]
  assigned_by bigint [not null]
  assigned_at timestamptz [not null, default: `now()`]
  indexes {
    (group_id, user_id) [pk]
  }
  Note: 'Thành viên hiện tại; kiểm tra active và ROLE_APPROVER lúc thêm, claim, quyết định.'
}

Table user_sessions {
  id uuid [pk, note: 'Sinh UUID ở ứng dụng; dùng sid trong token hoặc mã phiên đã băm.']
  user_id bigint [not null]
  token_hash varchar(128) [not null, unique, note: 'Băm secret phiên/refresh token nếu dùng.']
  auth_version bigint [not null, note: 'Bản auth_version của user tại lúc cấp.']
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    user_id
  }
  Note: 'Hỗ trợ logout từng phiên và thu hồi nhiều phiên; không lưu token rõ.'
}

Table workflow_definitions {
  id bigint [pk, increment]
  code varchar(100) [not null, unique]
  name varchar(200) [not null]
  description text
  is_active boolean [not null, default: true]
  created_by bigint [not null]
  lock_version bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Danh mục workflow; không phụ thuộc loại quy trình trong engine.'
}

Table workflow_versions {
  id bigint [pk, increment]
  workflow_definition_id bigint [not null]
  version_no integer [not null]
  status varchar(20) [not null, default: 'DRAFT', note: 'DRAFT / PUBLISHED / ARCHIVED.']
  form_schema jsonb [not null, note: 'Object fields; includes affects_approval. URL chỉ tham chiếu.']
  start_step_id bigint [note: 'Chỉ NULL khi còn nháp.']
  change_note text
  created_by bigint [not null]
  published_by bigint
  published_at timestamptz
  lock_version bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (workflow_definition_id, version_no) [unique]
  }
  Note: 'Cấu hình bất biến sau publish; trigger bảo vệ cả steps/transitions.'
}

Table workflow_steps {
  id bigint [pk, increment]
  workflow_version_id bigint [not null]
  step_key varchar(100) [not null]
  step_name varchar(200) [not null]
  display_order integer [not null, note: 'Thứ tự hiển thị, không thay thế đồ thị routing.']
  assignee_type varchar(30) [not null, note: 'USER / GROUP / REQUESTER_MANAGER / DEPARTMENT_MANAGER.']
  assignee_user_id bigint [note: 'Chỉ USER có giá trị.']
  assignee_group_id bigint [note: 'Chỉ GROUP có giá trị.']
  sla_hours integer [note: 'NULL nghĩa là không đặt SLA; nếu có phải dương.']
  allow_request_changes boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (id, workflow_version_id) [unique]
    (workflow_version_id, step_key) [unique]
    (workflow_version_id, display_order) [unique]
  }
  Note: 'Không có ID đa hình: dùng assignee_user_id hoặc assignee_group_id.'
}

Table workflow_transitions {
  id bigint [pk, increment]
  workflow_version_id bigint [not null]
  from_step_id bigint [not null]
  target_type varchar(20) [not null, note: 'STEP / END_APPROVED.']
  to_step_id bigint [note: 'NULL khi END_APPROVED; bắt buộc khi STEP.']
  condition_expression jsonb [not null, note: 'Object predicate hoặc all/any; mặc định là object rỗng.']
  is_default boolean [not null, default: false, note: 'Phải khớp condition_expression rỗng.']
  priority integer [not null, note: 'Giá trị nhỏ xét trước; mặc định có số lớn nhất.']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (from_step_id, priority) [unique]
  }
  Note: 'Nhánh có thể dẫn tới STEP hoặc END_APPROVED; đúng một mặc định cuối ở bước có nhánh.'
}

Table requests {
  id bigint [pk, increment]
  request_code varchar(100) [unique, note: 'NULL ở nháp; cấp lần đầu gửi thành công. Hủy nháp vẫn không cấp mã chính thức.']
  workflow_version_id bigint [not null, note: 'Nháp có thể đổi version sau xác nhận; khóa cứng khi gửi đầu.']
  requester_id bigint [not null]
  title varchar(250) [not null]
  status varchar(20) [not null, default: 'DRAFT', note: 'DRAFT / PENDING / RETURNED / APPROVED / REJECTED / CANCELLED.']
  source_department_id bigint [note: 'Snapshot ID phòng ban lúc gửi đầu.']
  source_manager_id bigint [note: 'Snapshot ID quản lý trực tiếp lúc gửi đầu.']
  source_department_manager_id bigint [note: 'Snapshot ID trưởng bộ phận lúc gửi đầu.']
  source_context jsonb [note: 'Snapshot tên/mã nguồn để hiển thị không phụ thuộc đổi tên hiện tại.']
  current_revision_id bigint [note: 'Revision đã gửi hiện hành; NULL trước gửi đầu.']
  current_step_id bigint [note: 'Bước đang xử lý hoặc bước vừa trả.']
  first_submitted_at timestamptz [note: 'Bất biến; dùng dashboard, không ghi đè khi gửi lại.']
  last_submitted_at timestamptz
  completed_at timestamptz
  cancel_reason text [note: 'Bắt buộc nếu CANCELLED.']
  lock_version bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (id, workflow_version_id) [unique]
    (requester_id, status, first_submitted_at)
    (status, first_submitted_at)
  }
  Note: 'Một hồ sơ kiêm runtime; không cần bảng workflow_instances trong MVP.'
}

Table request_revisions {
  id bigint [pk, increment]
  request_id bigint [not null]
  revision_no integer [not null, note: 'Bắt đầu 1; tăng dưới khóa hồ sơ.']
  form_data jsonb [not null]
  changed_fields jsonb [not null, note: 'Array các khóa đã đổi; revision 1 dùng array rỗng.']
  restart_required boolean [not null, note: 'Revision đầu TRUE; sau đó tính theo schema và diff.']
  resume_step_id bigint [not null, note: 'Start step nếu duyệt lại, bước trả nếu tiếp tục.']
  submitted_by bigint [not null]
  submitted_at timestamptz [not null]
  indexes {
    (request_id, revision_no) [unique]
    (id, request_id) [unique]
  }
  Note: 'INSERT ONLY: mỗi lần gửi một bản dữ liệu hoàn chỉnh; URL nằm trong form_data.'
}

Table request_edits {
  request_id bigint [pk]
  base_revision_id bigint [note: 'NULL ở nháp; bản gốc đang bổ sung nếu RETURNED.']
  form_data jsonb [not null]
  updated_by bigint [not null]
  lock_version bigint [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Một working copy cho nháp hoặc RETURNED; không coi là revision đã gửi.'
}

Table tasks {
  id bigint [pk, increment]
  request_id bigint [not null]
  workflow_version_id bigint [not null, note: 'Dùng composite FK kiểm version của bước.']
  workflow_step_id bigint [not null]
  revision_id bigint [not null, note: 'Bản dữ liệu task này xét, không sửa sang revision khác.']
  assignment_state varchar(20) [not null, note: 'ASSIGNED / GROUP_OPEN / NEEDS_ASSIGNMENT.']
  assignee_id bigint [note: 'NULL ở GROUP_OPEN hoặc NEEDS_ASSIGNMENT.']
  candidate_group_id bigint [note: 'Giữ nguồn nhóm cả sau claim; kiểm quyền theo assignment_state.']
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING / COMPLETED / CANCELLED.']
  action_taken varchar(30) [note: 'APPROVE / REJECT / REQUEST_CHANGES khi COMPLETED.']
  decision_reason text [note: 'Bắt buộc khi REJECT hoặc REQUEST_CHANGES.']
  claimed_at timestamptz
  completed_by bigint
  completed_at timestamptz [note: 'Kết thúc task; bắt buộc cả khi CANCELLED.']
  due_at timestamptz [note: 'Tính lúc tạo kể cả NEEDS_ASSIGNMENT; claim/reassign không thay.']
  lock_version bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (id, request_id) [unique]
    (assignee_id, status, due_at)
    (candidate_group_id, status, due_at)
    (request_id, created_at)
  }
  Note: 'Task chờ có thể chưa phân công; không fallback thành nhóm Admin.'
}

Table revision_approvals {
  request_id bigint [not null]
  revision_id bigint [not null]
  workflow_step_id bigint [not null]
  source_task_id bigint [not null, note: 'Task đã COMPLETED APPROVE, cùng hồ sơ/bước; có thể xét revision trước.']
  is_inherited boolean [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (revision_id, workflow_step_id) [pk]
  }
  Note: 'INSERT ONLY: quyết định APPROVE có hiệu lực cho từng revision và bước; cho phép truy nguồn quyết định được kế thừa.'
}

Table request_events {
  id bigint [pk, increment]
  event_key uuid [not null, unique, note: 'Một sự kiện logic; nguồn chống trùng thông báo.']
  request_id bigint [not null]
  revision_id bigint [note: 'NULL cho hủy nháp chưa gửi.']
  task_id bigint [note: 'NULL cho sự kiện không có task.']
  actor_id bigint [note: 'NULL khi hệ thống thực hiện.']
  event_type varchar(40) [not null, note: 'SUBMITTED / RESUBMITTED / CLAIMED / APPROVED / REJECTED / CHANGES_REQUESTED / CANCELLED / REASSIGNED / ASSIGNMENT_REQUIRED / ROUTING_FAILED / INCIDENT_RESOLVED / TASK_OVERDUE.']
  reason text [note: 'Lý do nghiệp vụ; không ghi secret.']
  old_assignee_id bigint
  new_assignee_id bigint
  details jsonb [not null, note: 'Object snapshot/diff và dữ liệu sự kiện.']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (request_id, created_at)
  }
  Note: 'Timeline INSERT ONLY cấp hồ sơ; không yêu cầu phải có task. Cũng lưu reassign trước/sau.'
}

Table audit_logs {
  id bigint [pk, increment]
  event_key uuid [not null, unique, note: 'Có thể dùng cùng event_key với request_events, không FK bắt buộc.']
  actor_id bigint
  request_id bigint
  revision_id bigint
  action varchar(80) [not null]
  entity_type varchar(60) [not null]
  entity_id varchar(100) [not null, note: 'Hỗ trợ bigint/UUID của đối tượng khác nhau.']
  details jsonb [not null, note: 'Before/after tối thiểu, không password/token.']
  ip_address varchar(45)
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (entity_type, entity_id, created_at)
    (actor_id, created_at)
    (request_id, created_at)
  }
  Note: 'Audit INSERT ONLY cả hành động quản trị không gắn hồ sơ; không gộp với timeline.'
}

Table notifications {
  id bigint [pk, increment]
  event_key uuid [not null, note: 'Định danh sự kiện; có thể là sự kiện hệ thống không gắn request_events.']
  user_id bigint [not null]
  notification_type varchar(40) [not null, note: 'TASK_ASSIGNED / TASK_OVERDUE / REQUEST_APPROVED / REQUEST_REJECTED / CHANGES_REQUESTED / TASK_REASSIGNED / ASSIGNMENT_REQUIRED / ROUTING_FAILED.']
  request_id bigint
  task_id bigint
  title varchar(250) [not null]
  message text
  read_at timestamptz [note: 'NULL nghĩa chưa đọc.']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (event_key, user_id, notification_type) [unique]
    (user_id, read_at, created_at)
  }
  Note: 'Một sự kiện, người nhận, loại chỉ một thông báo. Riêng quá hạn một người/task một lần.'
}

Table workflow_incidents {
  id bigint [pk, increment]
  request_id bigint [not null]
  revision_id bigint [not null]
  workflow_version_id bigint [not null]
  step_id bigint [not null]
  task_id bigint [note: 'Có task khi cần phân công; lỗi routing có thể chưa có task kế.']
  incident_type varchar(30) [not null, note: 'ASSIGNMENT_REQUIRED / ROUTING_ERROR.']
  status varchar(20) [not null, default: 'OPEN', note: 'OPEN / RESOLVED / CLOSED_CANCELLED.']
  operation_key uuid [not null, note: 'Liên kết lần thao tác lỗi; chống ghi lặp khi khôi phục.']
  error_code varchar(100) [not null]
  details jsonb [not null]
  resolved_by bigint
  resolution_reason text
  opened_at timestamptz [not null, default: `now()`]
  closed_at timestamptz
  indexes {
    (operation_key, incident_type) [unique]
    (request_id, status)
  }
  Note: 'Sự cố vận hành hiện tại và lịch sử giải quyết; cờ hiển thị được suy từ sự cố OPEN.'
}

Table command_receipts {
  id bigint [pk, increment]
  actor_id bigint [not null]
  command_type varchar(40) [not null, note: 'SUBMIT / RESUBMIT / CLAIM / DECISION / CANCEL / REASSIGN / RECOVER.']
  client_key uuid [not null, note: 'Client giữ cùng khóa khi retry cùng thao tác.']
  payload_hash varchar(64) [not null, note: 'Hash payload chuẩn hóa có target/revision/version; khác payload cùng khóa trả 409.']
  request_id bigint
  task_id bigint
  response_code integer [note: 'Chỉ có cùng response_body sau kết quả đã commit.']
  response_body jsonb [note: 'Không secret; chỉ lưu kết quả thuộc người thao tác.']
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  indexes {
    (actor_id, command_type, client_key) [unique]
  }
  Note: 'Chống lặp thao tác; khóa bản ghi và ghi kết quả trong cùng transaction nghiệp vụ.'
}

Ref: departments.parent_id > departments.id
Ref: departments.manager_id > users.id
Ref: users.department_id > departments.id
Ref: users.manager_id > users.id
Ref: user_roles.user_id > users.id
Ref: user_roles.role_id > roles.id
Ref: user_roles.assigned_by > users.id
Ref: approval_group_members.group_id > approval_groups.id
Ref: approval_group_members.user_id > users.id
Ref: approval_group_members.assigned_by > users.id
Ref: user_sessions.user_id > users.id
Ref: workflow_definitions.created_by > users.id
Ref: workflow_versions.workflow_definition_id > workflow_definitions.id
Ref: workflow_versions.created_by > users.id
Ref: workflow_versions.published_by > users.id
Ref: workflow_steps.workflow_version_id > workflow_versions.id
Ref: workflow_steps.assignee_user_id > users.id
Ref: workflow_steps.assignee_group_id > approval_groups.id
Ref: workflow_transitions.workflow_version_id > workflow_versions.id
Ref: requests.workflow_version_id > workflow_versions.id
Ref: requests.requester_id > users.id
Ref: requests.source_department_id > departments.id
Ref: requests.source_manager_id > users.id
Ref: requests.source_department_manager_id > users.id
Ref: request_revisions.request_id > requests.id
Ref: request_revisions.resume_step_id > workflow_steps.id
Ref: request_revisions.submitted_by > users.id
Ref: request_edits.request_id > requests.id
Ref: request_edits.updated_by > users.id
Ref: tasks.assignee_id > users.id
Ref: tasks.candidate_group_id > approval_groups.id
Ref: tasks.completed_by > users.id
Ref: revision_approvals.workflow_step_id > workflow_steps.id
Ref: request_events.request_id > requests.id
Ref: request_events.actor_id > users.id
Ref: request_events.old_assignee_id > users.id
Ref: request_events.new_assignee_id > users.id
Ref: audit_logs.actor_id > users.id
Ref: audit_logs.request_id > requests.id
Ref: notifications.user_id > users.id
Ref: notifications.request_id > requests.id
Ref: workflow_incidents.resolved_by > users.id
Ref: command_receipts.actor_id > users.id
Ref: command_receipts.request_id > requests.id
Ref: workflow_versions.(start_step_id, id) > workflow_steps.(id, workflow_version_id)
Ref: workflow_transitions.(from_step_id, workflow_version_id) > workflow_steps.(id, workflow_version_id)
Ref: workflow_transitions.(to_step_id, workflow_version_id) > workflow_steps.(id, workflow_version_id)
Ref: requests.(current_step_id, workflow_version_id) > workflow_steps.(id, workflow_version_id)
Ref: requests.(current_revision_id, id) > request_revisions.(id, request_id)
Ref: request_edits.(base_revision_id, request_id) > request_revisions.(id, request_id)
Ref: tasks.(request_id, workflow_version_id) > requests.(id, workflow_version_id)
Ref: tasks.(workflow_step_id, workflow_version_id) > workflow_steps.(id, workflow_version_id)
Ref: tasks.(revision_id, request_id) > request_revisions.(id, request_id)
Ref: revision_approvals.(revision_id, request_id) > request_revisions.(id, request_id)
Ref: revision_approvals.(source_task_id, request_id) > tasks.(id, request_id)
Ref: request_events.(revision_id, request_id) > request_revisions.(id, request_id)
Ref: request_events.(task_id, request_id) > tasks.(id, request_id)
Ref: audit_logs.(revision_id, request_id) > request_revisions.(id, request_id)
Ref: notifications.(task_id, request_id) > tasks.(id, request_id)
Ref: workflow_incidents.(revision_id, request_id) > request_revisions.(id, request_id)
Ref: workflow_incidents.(request_id, workflow_version_id) > requests.(id, workflow_version_id)
Ref: workflow_incidents.(step_id, workflow_version_id) > workflow_steps.(id, workflow_version_id)
Ref: workflow_incidents.(task_id, request_id) > tasks.(id, request_id)
Ref: command_receipts.(task_id, request_id) > tasks.(id, request_id)

TableGroup identity_and_organization {
  departments
  users
  roles
  user_roles
  approval_groups
  approval_group_members
  user_sessions
}
TableGroup workflow_configuration {
  workflow_definitions
  workflow_versions
  workflow_steps
  workflow_transitions
}
TableGroup workflow_runtime {
  requests
  request_revisions
  request_edits
  tasks
  revision_approvals
  request_events
}
TableGroup operations {
  audit_logs
  notifications
  workflow_incidents
  command_receipts
}
